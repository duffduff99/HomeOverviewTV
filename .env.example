# Copy to .env and fill in.

# Home Assistant URL as seen from this machine, and a long-lived access token
# (HA: your profile -> Security -> Long-lived access tokens -> Create token).
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# MQTT broker (the Mosquitto add-on usually lives on your HA host).
MQTT_HOST=homeassistant.local
MQTT_USERNAME=
MQTT_PASSWORD=

# Set to 1 to try the channel with fake data (no Home Assistant needed).
DEMO=0
LOG_LEVEL=INFO
